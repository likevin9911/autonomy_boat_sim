<?xml version="1.0" ?>
<!-- World containing sandisland model and some course challenges -->
<sdf version="1.6" xmlns:xacro="http://ros.org/wiki/xacro">
  <world name="robotx_example_course">
    <xacro:include filename="$(find vrx_2019)/worlds/sandisland.xacro" />
    <xacro:sandisland />
    <!--Waves-->
    <xacro:include filename="$(find wave_gazebo)/world_models/ocean_waves/model.xacro"/>
    <xacro:ocean_waves/>
    <!--include>
      <uri>model://obstacle_course0</uri>
      <pose>66.66 122.88 0.157 0 0 -1.12</pose>
    </include-->
    
    <include>
      <uri>model://robotx_light_buoy</uri>
      <pose>143.700 55.13693 0 0 0 0</pose> 
    </include>
    
    <include>
      <uri>model://dock_2022</uri>
      <pose>137.07 81.75 0.0 0 0 -1</pose>
    </include>
    
    <include>
      <uri>model://blue_totem</uri>
      <pose>127.598 94.61 0 0 0 0</pose>
    </include>
    
    <include>
      <uri>model://red_totem</uri>
      <pose>123.323 74.712 0 0 0 0</pose>
    </include>
    
    <include>
      <uri>model://green_totem</uri>
      <pose>142.717 108.67 0 0 0 0</pose>
    </include>
    
    <include>
      <uri>model://yellow_totem</uri>
      <pose>167.842 89.194 0 0 0 0</pose>
    </include>
    
    <include>
      <uri>model://black_totem</uri>
      <pose>148.342 122.216 0 0 0 0</pose>
    </include>     
    
    <!--include>
      <uri>model://simple_maze</uri>
      <pose>20.652985 14.555411 0 0 0 0.190745</pose>
    </include>-->
    
    <include>
      <uri>model://onepath_maze</uri>
      <pose>-35.5535 64.792 0 0 0 -1.42</pose>
    </include>
    
 
    <xacro:include filename="$(find vrx_gazebo)/worlds/xacros/usv_wind_plugin.xacro"/>
    <xacro:usv_wind_gazebo>
      <wind_objs>
        <wind_obj>
          <name></name>
          <link_name>base_link</link_name>
          <coeff_vector>.5 .5 .33</coeff_vector>
        </wind_obj>
      </wind_objs>
    </xacro:usv_wind_gazebo>
  </world>
</sdf>

    
  
